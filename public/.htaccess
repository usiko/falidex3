# Enable compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
</IfModule>

# Set cache expiration
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Cache manifest files for short period
  ExpiresByType text/cache-manifest "access plus 1 hour"
  ExpiresByType application/manifest+json "access plus 1 hour"
  
  # Cache service worker
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
  
  # Cache images for long period
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Cache fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  
  # Cache CSS
  ExpiresByType text/css "access plus 1 week"
  
  # HTML files - cache for short period
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/xhtml+xml "access plus 1 hour"
</IfModule>

# Set cache headers
<IfModule mod_headers.c>
  # Cache manifest
  <FilesMatch "\.webmanifest$|manifest\.json$">
    Header set Cache-Control "public, must-revalidate, max-age=3600"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
  
  # Service worker
  <FilesMatch "ngsw-worker\.js$">
    Header set Cache-Control "public, must-revalidate, max-age=3600"
    Header set Service-Worker-Allowed "/"
  </FilesMatch>
  
  # HTML files
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, must-revalidate, max-age=3600"
    Header set X-UA-Compatible "IE=edge"
  </FilesMatch>
  
  # CSS and JS
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  
  # Images, fonts
  <FilesMatch "\.(jpg|jpeg|png|gif|ico|svg|webp|ttf|otf|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# Rewrite rules for Angular routing (SPA)
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Remove trailing slashes
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)/$ /$1 [L,R=301]
  
  # Rewrite to index.html for non-existent files/folders
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [QSA,L]
  
  # Ensure robots.txt and sitemap.xml are served
  RewriteCond %{REQUEST_FILENAME} robots\.txt$ [OR]
  RewriteCond %{REQUEST_FILENAME} sitemap\.xml$
  RewriteRule ^ - [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>

{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "google-analytics",
      "urls": [
        "https://www.googletagmanager.com/**",
        "https://www.google-analytics.com/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 0,
        "maxAge": "0s"
      }
    },
    {
        "name": "falidex-resources",
        "urls": [
            "https://resources.falidex.fr/**"
        ],
        "cacheConfig": {
        "strategy": "performance",
        "maxSize": 100,
        "maxAge": "14d",
        "timeout": "10s"
        }
    }
  ]
}